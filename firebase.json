{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix functions run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist/cotizacion-web/browser",
    "predeploy": [],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=604800"
          }
        ]
      },
      {
        "source": "/dashboard/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/@(login|registro|recuperar-clave|auth|producto)",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/cuenta/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "api",
          "region": "southamerica-west1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "southamerica-west1"
        }
      },
      {
        "source": "/producto",
        "function": {
          "functionId": "api",
          "region": "southamerica-west1"
        }
      },
      {
        "source": "/productos/**",
        "function": {
          "functionId": "api",
          "region": "southamerica-west1"
        }
      },
      {
        "source": "/@(buscar|producto|maestros|ferreterias|contacto|terminos-condiciones|privacidad|propiedad-intelectual|desuscribir|reportar-precio|preguntas-frecuentes|login|registro|recuperar-clave|auth)",
        "destination": "/index.html"
      },
      {
        "source": "/dashboard/**",
        "destination": "/index.html"
      },
      {
        "source": "/cuenta/**",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "function": {
          "functionId": "api",
          "region": "southamerica-west1"
        }
      }
    ],
    "redirects": [
      {
        "source": "/auth",
        "destination": "/login",
        "type": 301
      }
    ]
  }
}
