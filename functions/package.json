{
  "name": "cotizapp-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc && cd .. && node functions/scripts/copy-web-template.mjs",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,hosting",
    "deploy": "firebase deploy --only functions,firestore:rules",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
