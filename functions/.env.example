
# Server-side storage selection. PostgreSQL is enabled for Findi.
# For a fresh database, keep false until migration and reconciliation finish.
USE_SQL_DATABASE=true
SQL_INSTANCE_CONNECTION_NAME=cotizapp-d71c8:us-east4:cotizapp-d71c8-instance
SQL_DATABASE_NAME=cotizapp-d71c8-database
SQL_DATABASE_USER=findi_runtime
# FINDI_SQL_PASSWORD is a Firebase/Secret Manager secret, never a frontend variable.
# Internal synchronization guard, enabled after bootstrap.
SQL_REPLICATION_ENABLED=false
