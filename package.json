{
  "name": "cotizacion-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 5010",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "functions:build": "npm --prefix functions run build",
    "functions:serve": "npm --prefix functions run serve",
    "seed:firebase": "node functions/scripts/seed-firestore.mjs",
    "security:disable-demo-auth": "node functions/scripts/disable-demo-auth.mjs",
    "deploy": "npm run build && npm run functions:build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "npm --prefix functions run build && firebase deploy --only functions,firestore:rules",
    "scrape:construmart": "node scripts/scrape-construmart.mjs",
    "serve:ssr:cotizacion-web": "node dist/cotizacion-web/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.0",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "express": "^4.18.2",
    "firebase": "^12.19.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.16.0",
    "@primeuix/themes": "^2.0.3"
  },
  "devDependencies": {
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^4.17.17",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "@angular/build": "^21.2.24",
    "vitest": "^4.0.0",
    "jsdom": "^27.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "piscina": "^5.3.2"
  }
}
